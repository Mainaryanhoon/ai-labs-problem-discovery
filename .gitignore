# Secrets — never commit real credentials
.env
.env.*
!.env.example
.agent/.env
.agent/.env
# Gmail OAuth (MASTER §7.1) — never commit client secrets or tokens
data/secrets/
**/client_secret*.json
**/gmail_token.json
**/gmail-credentials*.json

# Python environments and cache
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/

# Local data and databases
data/
*.db
*.sqlite
*.sqlite3

# Editor and OS files
.vscode/
.DS_Store
Thumbs.db
frontend/tsconfig.tsbuildinfo
**/build/

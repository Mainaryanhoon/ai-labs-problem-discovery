# Copy to .env and fill in locally. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DATABASE_URL=sqlite:///./data/problem_discovery.db

# Apify (Reddit and X collection)
APIFY_API_TOKEN=
APIFY_REDDIT_ACTOR_ID=anyxsolutions~reddit-scraper
APIFY_X_ACTOR_ID=apidojo~tweet-scraper

# Optional protections. Empty / zero disables them.
# When configured, every application API endpoint except /health requires X-API-Key.
SERVICE_API_KEY=
# POST /api/submissions per client address, per worker process.
SUBMISSION_RATE_LIMIT_PER_MINUTE=0

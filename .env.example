# Copy to .env and fill in locally. Never commit .env.

# --- LiteLLM (primary analysis engine) ---
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_API_KEY=your_litellm_api_key_here
LITELLM_MODEL=qwen3.8-27b
LITELLM_EMBEDDING_MODEL=
LITELLM_MAX_TOKENS=4096

# Optional Gemini fallback (only used when LITELLM_API_KEY is empty)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

DATABASE_URL=sqlite:///./data/problem_discovery.db

# Apify — Reddit (default wave), X/YouTube (opt-in only)
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_REDDIT_ACTOR_ID=anyxsolutions~reddit-scraper
APIFY_X_ACTOR_ID=apidojo~tweet-scraper
APIFY_YOUTUBE_ACTOR_ID=streamers~youtube-scraper

# Articles — RSS discovery, then Firecrawl (optional), then Playwright.
# Empty FIRECRAWL_API_KEY skips Firecrawl; Playwright is the fallback.
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# Optional override; empty = built-in Google Cloud analytics/AI feeds
ARTICLE_FEED_URLS=

# Weekly collectors (scripts/weekly_run.py)
# Hacker News and Stack Overflow always run. Reddit / X / YouTube are opt-in.
LEADS_COLLECT_LIMIT=80
LEADS_MAX_LLM_CALLS=40
# ENABLE_REDDIT=true
# ENABLE_X=true
# ENABLE_YOUTUBE=true

# YouTube ingestion: primary path is YouTube Data API v3; Apify actor is the fallback.
YOUTUBE_API_KEY=your_youtube_data_api_key_here
YOUTUBE_MAX_RESULTS_PER_CHANNEL=10
YOUTUBE_CHANNEL_URLS=

# CEO weekly/monthly reports — saved under data/reports/
# Optional email: Gmail API only (MASTER §7.1). SMTP is not used by weekly_run.
# One-time OAuth: .venv/bin/python scripts/gmail_oauth_setup.py
CEO_EMAIL=ceo@example.com, reviewer@example.com
GMAIL_FROM_EMAIL=
GMAIL_CLIENT_SECRETS_FILE=/path/to/client_secret.json
GMAIL_TOKEN_FILE=data/secrets/gmail_token.json
REPORT_PUBLIC_BASE_URL=http://localhost:5173
REPORT_OUTPUT_DIR=data/reports
MONTHLY_TOP_K=6

# Legacy SMTP placeholders (optional; not used by Gmail API send path)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Optional API protections. Empty / zero disables them.
SERVICE_API_KEY=
SUBMISSION_RATE_LIMIT_PER_MINUTE=0
